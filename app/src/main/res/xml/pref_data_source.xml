<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:title="@string/hardware_data_source">
        <ListPreference
            android:key="dex_collection_method"
            android:title="@string/hardware_data_source"
            android:entries="@array/dex_collection_method_entries"
            android:entryValues="@array/dex_collection_method_values"
            android:defaultValue="DexcomG5" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/other_misc_options">
        <CheckBoxPreference
            android:key="use_transmiter_pl_bluetooth"
            android:title="@string/scan_for_bluetooth"
            android:summary="@string/use_bluetooth_for_dexcom_share_receiver"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="close_gatt_on_ble_disconnect"
            android:title="@string/close_gatt_on_ble_disconnect"
            android:summary="@string/workaround_for_some_phones"
            android:defaultValue="false" />
        <EditTextPreference
            android:key="dex_txid"
            android:title="@string/dexcom_transmitter_id"
            android:summary="@string/5_or_6_character_transmitter_id"
            android:defaultValue="" />
    </PreferenceCategory>

</PreferenceScreen>
